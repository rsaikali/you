# Domain served by nginx-proxy-manager (used by provision.sh)
DOMAIN=you.saikali.fr

# Public URL of the Umami instance (for the analytics script src)
UMAMI_PUBLIC_URL=https://you.saikali.fr/analytics

# Internal URL of the Umami instance (for the server-side API calls)
# Note: direct port access, no BASE_PATH prefix — API routes are at the root
UMAMI_INTERNAL_URL=http://localhost:8300

# Umami admin password — change before first 'make provision'
UMAMI_ADMIN_PASSWORD=change-me-in-production

# Umami internals
UMAMI_SECRET=change-me-in-production
UMAMI_DB_PASSWORD=change-me-in-production

